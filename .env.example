# Server
HOST=0.0.0.0
PORT=8100
PAYMENTS_MONGO_URI=
# PAYMENTS_MONGO_URI=mongodb+srv://...
MONGO_DB=payments

# Product API keys (ScanLead / JobPilot send X-Product-Key)
PAYMENTS_KEY_SCANLEAD=dev-scanlead-key-change-me
PAYMENTS_KEY_JOBPILOT=dev-jobpilot-key-change-me
PAYMENTS_ADMIN_KEY=dev-admin-key-change-me

# Polar (sandbox first)
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SUCCESS_URL_DEFAULT=https://vulscan.duckdns.org/pricing?paid=1

# Filled by scripts/ensure_polar_catalog.py
POLAR_SCANLEAD_PRO_MONTHLY_PRODUCT_ID=
POLAR_SCANLEAD_PRO_YEARLY_PRODUCT_ID=
# POLAR_JOBPILOT_PRO_MONTHLY_PRODUCT_ID=

# When Polar token missing, allow mock checkout URLs for local smoke tests
ALLOW_MOCK_PROVIDER=true
